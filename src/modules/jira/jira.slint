import { Button, VerticalBox, HorizontalBox, LineEdit, TextEdit, ScrollView, ListView } from "std-widgets.slint";

export struct ProposalData {
    id: int,
    action: string,
    target-key: string,
    issue-type: string,
    summary: string,
    description: string,
    acceptance-criteria: string,
    rationale: string,
    status: string,
    result: string,
}

export component AppWindow inherits Window {
    title: "Meeting to Jira (Slint + Rust)";
    preferred-width: 560px;
    preferred-height: 640px;

    // Callbacks to Rust
    callback toggle-recording();
    callback send-message();
    callback analyze();
    callback update-proposal(int, string, string);
    callback approve-proposal(int);
    callback reject-proposal(int);

    // State properties managed by Rust
    in property <bool> is-recording: false;
    in property <bool> analyzing: false;
    in property <string> status-msg: "Idle - Ready to record";
    in property <string> transcript: "";
    in property <string> llm-response: "";
    in property <string> detected-issues: "";
    in-out property <string> project-key: "PROJ";
    in-out property <string> input-text: "";
    in property <[ProposalData]> proposals: [];

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "🎙️ Meeting to Jira Story Assistant";
            font-size: 18px;
            font-weight: 700;
        }

        // --- CONTROLS ---
        HorizontalBox {
            padding: 0px;
            Button {
                text: root.is-recording ? "⏹️ Stop" : "🔴 Start Recording";
                clicked => { root.toggle-recording(); }
            }
            Button {
                text: "🔎 Analyze for Jira changes";
                enabled: !root.analyzing;
                clicked => { root.analyze(); }
            }
        }

        Text {
            text: "Status: " + root.status-msg;
            color: root.is-recording ? #d9534f : #5bc0de;
        }

        // --- TEXT INPUT (alternative to speech) ---
        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            LineEdit {
                placeholder-text: "Type a message to the assistant, then press Enter…";
                text <=> root.input-text;
                accepted => { root.send-message(); }
            }
            Button {
                text: "➤ Send";
                enabled: root.input-text != "";
                clicked => { root.send-message(); }
            }
        }

        // --- LIVE TRANSCRIPT ---
        Text { text: "Live Transcript"; font-size: 14px; font-weight: 600; }
        Rectangle {
            height: 90px;
            background: #ffffff;
            border-radius: 4px;
            border-width: 1px;
            border-color: #e0e0e0;
            ScrollView {
                Text {
                    x: 6px;
                    width: parent.width - 12px;
                    wrap: word-wrap;
                    color: #222;
                    text: root.transcript == "" ? "(transcript will appear here while recording…)" : root.transcript;
                }
            }
        }

        // --- ASSISTANT RESPONSE ---
        Text { text: "Assistant Notes"; font-size: 14px; font-weight: 600; }
        Rectangle {
            height: 70px;
            background: #f4f8ff;
            border-radius: 4px;
            border-width: 1px;
            border-color: #cfe0ff;
            ScrollView {
                Text {
                    x: 6px;
                    width: parent.width - 12px;
                    wrap: word-wrap;
                    color: #143;
                    text: root.llm-response == "" ? "(the assistant's running notes appear here…)" : root.llm-response;
                }
            }
        }

        Rectangle { height: 1px; background: #ccc; }

        // --- CONFIGURATION + DETECTED ISSUES ---
        HorizontalBox {
            padding: 0px;
            Text { text: "Jira Project Key:"; vertical-alignment: center; }
            LineEdit { text <=> root.project-key; }
        }
        if root.detected-issues != "" : Text {
            text: "Issues under discussion: " + root.detected-issues;
            color: #555;
            wrap: word-wrap;
        }

        Text { text: "Proposed Changes (review & edit before applying)"; font-size: 14px; font-weight: 600; }

        if root.proposals.length == 0 : Text {
            text: "No proposals yet. Click ‘Analyze for Jira changes’.";
            color: #888;
        }

        ListView {
            for p in root.proposals : Rectangle {
                background: p.status == "applied" ? #eaf7ea
                    : p.status == "rejected" ? #f2f2f2
                    : p.status == "error" ? #fdecea
                    : #f8f9fa;
                border-radius: 6px;
                border-width: 1px;
                border-color: #e0e0e0;

                VerticalBox {
                    padding: 8px;
                    spacing: 4px;

                    HorizontalBox {
                        padding: 0px;
                        spacing: 8px;
                        Text {
                            text: (p.action == "update" ? "✏️ UPDATE" : "➕ CREATE");
                            font-weight: 700;
                            color: p.action == "update" ? #b8860b : #2e7d32;
                            vertical-alignment: center;
                        }
                        Text { text: "Type:"; vertical-alignment: center; }
                        LineEdit {
                            width: 90px;
                            text: p.issue-type;
                            edited(t) => { root.update-proposal(p.id, "issue_type", t); }
                        }
                        Text { text: "Target:"; vertical-alignment: center; }
                        LineEdit {
                            width: 100px;
                            placeholder-text: "KEY-123";
                            text: p.target-key;
                            edited(t) => { root.update-proposal(p.id, "target_key", t); }
                        }
                    }

                    Text { text: "Summary"; font-size: 12px; color: #666; }
                    LineEdit {
                        text: p.summary;
                        edited(t) => { root.update-proposal(p.id, "summary", t); }
                    }

                    Text { text: "Description"; font-size: 12px; color: #666; }
                    Rectangle {
                        height: 60px;
                        background: white;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #ddd;
                        TextEdit {
                            width: parent.width;
                            height: parent.height;
                            wrap: word-wrap;
                            text: p.description;
                            edited(t) => { root.update-proposal(p.id, "description", t); }
                        }
                    }

                    Text { text: "Acceptance criteria"; font-size: 12px; color: #666; }
                    Rectangle {
                        height: 48px;
                        background: white;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #ddd;
                        TextEdit {
                            width: parent.width;
                            height: parent.height;
                            wrap: word-wrap;
                            text: p.acceptance-criteria;
                            edited(t) => { root.update-proposal(p.id, "acceptance_criteria", t); }
                        }
                    }

                    if p.rationale != "" : Text {
                        text: "Why: " + p.rationale;
                        font-size: 11px;
                        color: #777;
                        wrap: word-wrap;
                    }

                    if p.status == "applied" || p.status == "error" : Text {
                        text: p.result;
                        color: p.status == "error" ? #c0392b : #2e7d32;
                        wrap: word-wrap;
                    }

                    if (p.status == "pending" || p.status == "approved") && p.result != "" : Text {
                        text: p.result;
                        color: #1565c0;
                        font-italic: true;
                        wrap: word-wrap;
                    }

                    if p.status == "pending" || p.status == "approved" : HorizontalBox {
                        padding: 0px;
                        alignment: end;
                        spacing: 8px;
                        Button {
                            text: "✅ Approve & Apply";
                            enabled: p.status == "pending";
                            clicked => { root.approve-proposal(p.id); }
                        }
                        Button {
                            text: "🗑️ Reject";
                            clicked => { root.reject-proposal(p.id); }
                        }
                    }
                }
            }
        }
    }
}
